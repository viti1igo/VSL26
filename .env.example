# Copy to .env and fill values locally. Do not commit .env.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4
OPENAI_MODEL=gpt-5.4

# Optional: point inference.py at a non-default LayoutLMv3 checkpoint.
# If unset, inference.py reads models/latest_layoutlmv3_vaipe_retrain.txt
# when that file exists.
VSL_LAYOUTLMV3_CHECKPOINT=models/layoutlmv3_vaipe_retrain_YYYYMMDD_HHMMSS/final
